# Copy this file to .env only if you are creating a new local environment.
# Keep your real .env private and never commit it.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Flask session signing key. setup_admin.py can generate this automatically.
SECRET_KEY=

# Server-side admin credentials. Never put these in HTML or JavaScript.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Private recovery key used only by /admin/forgot-password. Keep this secret.
ADMIN_RESET_TOKEN=

# Use 1 only when the app is served over HTTPS.
# Keep 0 for local http://127.0.0.1 development.
SESSION_COOKIE_SECURE=0
